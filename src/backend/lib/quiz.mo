  public func getAllQuestions() : [QuizQuestion] { allQuestions() };

  public func getQuestionById(id : Text) : ?QuizQuestion {
    allQuestions().find(func(q) { q.id == id })
  };

  public func getByDifficultyAndTopic(difficulty : Text, topic : Text) : [QuizQuestion] {
    let matchDiff = difficulty == "";
    let matchTopic = topic == "";
    allQuestions().filter(func(q) {
      (matchDiff or q.difficulty == difficulty) and
      (matchTopic or q.topic == topic)
    })
  };
};
