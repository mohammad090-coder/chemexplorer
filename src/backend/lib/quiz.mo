    // ── NEW Assertion-Reason (40 questions) ─────────────────────────────────
    q("ar-01","assertion_reason","Assertion (A): Noble gases are chemically inert.\nReason (R): They have completely filled outermost shells.",
      ["Both A and R true, R explains A","Both true, R doesn't explain A","A true, R false","A false, R true"],
      "Both A and R true, R explains A","Full valence shell → no tendency to react; R correctly explains A.","easy","periodic-table"),
    q("ar-02","assertion_reason","A: Ionic compounds have high melting points.\nR: They have strong electrostatic forces between ions.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Strong ionic lattice requires much energy to break.","easy","bonding"),
    q("ar-03","assertion_reason","A: H2O has a bent shape.\nR: The central O atom has 2 lone pairs.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Lone pairs repel, compressing bond angle to 104.5°.","medium","bonding"),
    q("ar-04","assertion_reason","A: Graphite conducts electricity.\nR: Graphite has delocalised π electrons.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Delocalised electrons free to move → conduction.","medium","element-identification"),
    q("ar-05","assertion_reason","A: Electronegativity increases across a period.\nR: Nuclear charge increases across a period.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Greater nuclear charge attracts bonding electrons more.","medium","periodic-trends"),
    q("ar-06","assertion_reason","A: Rate of reaction increases with temperature.\nR: More molecules have energy ≥ Ea at higher T.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Maxwell-Boltzmann: higher T shifts distribution to higher energies.","medium","kinetics"),
    q("ar-07","assertion_reason","A: All spontaneous reactions are exothermic.\nR: Spontaneity is determined by ΔG only.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "A false R true","Endothermic reactions can be spontaneous if ΔS is large; ΔG = ΔH - TΔS.","hard","thermochemistry"),
    q("ar-08","assertion_reason","A: Boiling point of HF > HCl.\nR: HF forms stronger hydrogen bonds than HCl.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","F's high electronegativity makes strong H-bonds in HF.","medium","bonding"),
    q("ar-09","assertion_reason","A: Adding catalyst doesn't change equilibrium position.\nR: Catalyst equally lowers Ea for forward and reverse.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Both rates increase equally; Kc unchanged.","medium","equilibrium"),
    q("ar-10","assertion_reason","A: Atomic radius decreases across a period.\nR: Number of electron shells increases across a period.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "A true R false","Shells don't increase across a period; radius decreases due to nuclear charge.","hard","periodic-trends"),
    q("ar-11","assertion_reason","A: CO2 is a non-polar molecule.\nR: The C=O bonds cancel due to linear geometry.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Linear geometry: equal and opposite dipoles sum to zero.","medium","bonding"),
    q("ar-12","assertion_reason","A: First ionisation energy of Mg > Na.\nR: Mg has greater nuclear charge than Na.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","More protons pull outer electrons more tightly.","medium","periodic-trends"),
    q("ar-13","assertion_reason","A: Rusting of iron is an electrochemical process.\nR: Rusting requires both O2 and H2O.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R doesn't explain A","Both statements true but R is a condition, not the reason for electrochemical nature.","hard","redox"),
    q("ar-14","assertion_reason","A: Phenol is more acidic than ethanol.\nR: Phenoxide ion is stabilised by resonance.",
      ["Both true, R explains A","Both true, R doesn't explain A","A true R false","A false R true"],
      "Both true, R explains A","Resonance delocalises negative charge in C6H5O-.","hard","organic"),
    q("ar-15","assertion_reason","A: Solubility of gases increases with pressure.\nR: Henry's law states C = kH × P.",
