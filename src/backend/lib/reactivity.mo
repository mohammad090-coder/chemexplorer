  // ── public API ─────────────────────────────────────────────────────────────
  public func getAllMetals() : [ReactivityMetal] { allMetals() };

  public func getMetalBySymbol(symbol : Text) : ?ReactivityMetal {
    let metals = allMetals();
    metals.find(func(m) { m.symbol == symbol })
  };

  public func getAllReactions() : [ChemicalReaction] { allReactions() };

  public func getReactionById(id : Text) : ?ChemicalReaction {
    let reactions = allReactions();
    reactions.find(func(r) { r.id == id })
  };

  public func searchReactions(term : Text) : [ChemicalReaction] {
    let lower = term.toLower();
    let reactions = allReactions();
    reactions.filter(func(r) {
      r.name.toLower().contains(#text lower) or
      r.reactionType.toLower().contains(#text lower) or
      r.description.toLower().contains(#text lower) or
      r.balancedEquation.toLower().contains(#text lower) or
      r.category.toLower().contains(#text lower) or
      r.namedReaction.toLower().contains(#text lower)
    })
  };

  public func getReactionsByCategory(category : Text) : [ChemicalReaction] {
    let lower = category.toLower();
    let reactions = allReactions();
    reactions.filter(func(r) { r.category.toLower() == lower })
  };

  public func getReactionsByType(rtype : Text) : [ChemicalReaction] {
    let lower = rtype.toLower();
    let reactions = allReactions();
    reactions.filter(func(r) { r.reactionType.toLower() == lower })
  };
};
