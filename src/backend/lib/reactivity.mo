import Array "mo:core/Array";
import Types "../types/reactivity";

module {
  public type ReactivityMetal = Types.ReactivityMetal;
  public type ChemicalReaction = Types.ChemicalReaction;

  // ── helpers ────────────────────────────────────────────────────────────────
  func r(reactionType : Text, partner : Text, equation : Text, observation : Text) : Types.MetalReaction =
    { reactionType; partner; equation; observation };

  func m(symbol : Text, name : Text, rank : Nat, reactions : [Types.MetalReaction], interestingFacts : [Text]) : ReactivityMetal =
    { symbol; name; rank; reactions; interestingFacts };

  func reactant(symbol : Text, name : Text, coefficient : Nat) : Types.ChemicalReactant =
    { symbol; name; coefficient };

  func product(symbol : Text, name : Text, formula : Text, coefficient : Nat) : Types.ChemicalProduct =
    { symbol; name; formula; coefficient };

  func rxn(
    id : Text, name : Text,
    reactants : [Types.ChemicalReactant], products : [Types.ChemicalProduct],
    balancedEquation : Text, reactionType : Text, energyChange : Text,
    description : Text, observations : [Text],
    category : Text, namedReaction : Text
  ) : ChemicalReaction =
    { id; name; reactants; products; balancedEquation; reactionType; energyChange; description; observations; category; namedReaction };

  // ── reactivity series data ─────────────────────────────────────────────────
  func allMetals() : [ReactivityMetal] { [
    m("K",  "Potassium",  1,
      [r("metal+water","Water","2K + 2H₂O → 2KOH + H₂↑","Extremely violent; ignites spontaneously, lilac flame"),
       r("metal+acid","HCl","2K + 2HCl → 2KCl + H₂↑","Dangerously explosive, not performed in lab")],
      ["Most reactive common metal","Burns with lilac-purple flame","Stored under mineral oil","Ignites the H₂ produced in water"]),
    m("Na",  "Sodium",    2,
      [r("metal+water","Water","2Na + 2H₂O → 2NaOH + H₂↑","Vigorous; melts into ball, skips across water"),
       r("metal+acid","HCl","2Na + 2HCl → 2NaCl + H₂↑","Very vigorous, potentially explosive")],
      ["Burns with bright yellow flame","Stored under oil","Reacts violently with water","Used in nerve signal transmission"]),
    m("Li",  "Lithium",   3,
      [r("metal+water","Water","2Li + 2H₂O → 2LiOH + H₂↑","Steady effervescence, less violent than Na or K"),
       r("metal+acid","HCl","2Li + 2HCl → 2LiCl + H₂↑","Rapid, produces hydrogen gas")],
      ["Lightest metal","Burns crimson-red","Used in Li-ion batteries","Lithium carbonate treats bipolar disorder"]),
    m("Ca",  "Calcium",   4,
      [r("metal+water","Water","Ca + 2H₂O → Ca(OH)₂ + H₂↑","Steady bubbling, water turns milky"),
       r("metal+acid","HCl","Ca + 2HCl → CaCl₂ + H₂↑","Rapid effervescence")],
      ["Most abundant metal in human body","Reacts steadily with water","Burns brick-red","Essential for bones"]),
    m("Mg",  "Magnesium", 5,
      [r("metal+water","Water","Mg + 2H₂O → Mg(OH)₂ + H₂↑","Very slow cold water; vigorous with steam"),
       r("metal+acid","HCl","Mg + 2HCl → MgCl₂ + H₂↑","Rapid, vigorous effervescence")],
      ["Burns with blinding white flame","Reacts slowly with cold water","Lightest structural engineering metal","Essential for chlorophyll"]),
    m("Al",  "Aluminium", 6,
      [r("metal+water","Water","2Al + 6H₂O → 2Al(OH)₃ + 3H₂↑","Barely reacts due to oxide layer"),
       r("metal+acid","HCl","2Al + 6HCl → 2AlCl₃ + 3H₂↑","Rapid once surface oxide dissolves")],
      ["Protected by invisible oxide layer","3rd most abundant element in crust","Appears unreactive due to passivation","Used in Thermite reaction"]),
    m("Zn",  "Zinc",      7,
      [r("metal+water","Water","Zn + H₂O → ZnO + H₂↑","Reacts with steam; very slow with cold water"),
       r("metal+acid","HCl","Zn + 2HCl → ZnCl₂ + H₂↑","Moderate steady effervescence")],
      ["Used to galvanise iron","Burns blue-green","Essential trace element","Found in 300+ human enzymes"]),
    m("Fe",  "Iron",      8,
      [r("metal+water","Water","3Fe + 4H₂O → Fe₃O₄ + 4H₂↑","Only with steam; no cold water reaction"),
       r("metal+acid","HCl","Fe + 2HCl → FeCl₂ + H₂↑","Slow steady reaction")],
      ["Only reacts with steam, not liquid water","Rusting is slow electrochemical corrosion","Earth's inner core is solid iron","Haemoglobin uses iron to carry oxygen"]),
    m("Ni",  "Nickel",    9,
      [r("metal+water","Water","Ni + H₂O → No significant reaction","Does not react appreciably"),
       r("metal+acid","HCl","Ni + 2HCl → NiCl₂ + H₂↑","Slow, gradual dissolution")],
      ["Used in NiMH batteries","Highly corrosion-resistant","Named from German 'goblin copper'","Earth's core contains nickel"]),
    m("Sn",  "Tin",       10,
      [r("metal+water","Water","Sn + H₂O → No significant reaction","No reaction under standard conditions"),
       r("metal+acid","HCl","Sn + 2HCl → SnCl₂ + H₂↑","Slow dissolution in dilute acid")],
      ["First metals smelted by humans","Bronze = copper + tin","Below 13.2°C turns to brittle grey tin","Coats steel cans to prevent rust"]),
    m("Pb",  "Lead",      11,
      [r("metal+water","Water","Pb + H₂O → No significant reaction","Insoluble oxide coating prevents reaction"),
       r("metal+acid","HCl","Pb + 2HCl → PbCl₂ + H₂↑","Very slow, PbCl₂ forms protective layer")],
      ["Dense, soft, low melting point","Used in car batteries","Highly toxic, banned from paints","Roman pipes were lead (plumbum → Pb)"]),
    m("H",   "Hydrogen",  12,
      [r("non-metal+acid","HCl","H₂ + Cl₂ → 2HCl","Explosive in light or spark"),
       r("reference","","","Reference point in reactivity series")],
      ["Divides metals that displace H₂ from acid vs those that cannot","Most abundant element in universe","Burns with almost invisible pale blue flame","Powers the Sun via nuclear fusion"]),
    m("Cu",  "Copper",    13,
      [r("metal+water","Water","Cu + H₂O → No reaction","Does not react with water"),
       r("metal+acid","HCl","Cu + 2HCl → No significant reaction","Reacts only with oxidising acids like HNO₃")],
      ["Below hydrogen, cannot displace H₂ from acids","Used by humans for 10,000+ years","Natural antimicrobial properties","Turns green (verdigris) in air"]),
    m("Hg",  "Mercury",   14,
      [r("metal+water","Water","Hg + H₂O → No reaction","Does not react with water"),
       r("metal+acid","HNO₃","3Hg + 8HNO₃(dilute) → 3Hg(NO₃)₂ + 2NO + 4H₂O","Dissolves in oxidising acids")],
      ["Only liquid metal at room temperature","Used in old thermometers","Highly toxic to nervous system","Symbol Hg from Hydrargyrum (liquid silver)"]),
    m("Ag",  "Silver",    15,
      [r("metal+water","Water","Ag + H₂O → No reaction","Does not react with water"),
       r("metal+acid","HNO₃","3Ag + 4HNO₃(dilute) → 3AgNO₃ + NO + 2H₂O","Dissolves in nitric acid")],
      ["Best electrical conductor","Natural antimicrobial properties","Used in currency for millennia","Silver mirror reaction silvers glass"]),
    m("Au",  "Gold",      16,
      [r("metal+water","Water","Au + H₂O → No reaction","Does not react with water"),
       r("metal+acid","Aqua regia","Au + HNO₃ + 3HCl → AuCl₃ + NO + 2H₂O","Only dissolves in aqua regia")],
      ["Least reactive common metal","Does not corrode or tarnish","Only aqua regia dissolves it","Valued since earliest civilisations"]),
    m("Pt",  "Platinum",  17,
      [r("metal+water","Water","Pt + H₂O → No reaction","Does not react with water"),
       r("metal+acid","Aqua regia","Pt + 4HNO₃ + 6HCl → H₂[PtCl₆] + 4NO₂ + 4H₂O","Dissolves only in hot aqua regia")],
      ["Most corrosion-resistant metal","Vital catalyst in catalytic converters","Named from Spanish 'platina' (little silver)","Highest melting point of platinum group"]),
  ] };

  // ── chemical reactions data ────────────────────────────────────────────────
  func allReactions() : [ChemicalReaction] { [
    // ── Inorganic: Combustion ─────────────────────────────────────────────
    rxn("comb-h2-o2","Combustion of Hydrogen",
      [reactant("H₂","Hydrogen",2),reactant("O₂","Oxygen",1)],
      [product("H₂O","Water","H₂O",2)],
      "2H₂ + O₂ → 2H₂O","combustion","exothermic",
      "Hydrogen burns in oxygen to form water. Powers rocket engines and hydrogen fuel cells.",
      ["Pale blue invisible flame","Only water produced – no CO₂","Powers Space Shuttle engines"],
      "inorganic",""),
    rxn("comb-c-o2","Combustion of Carbon",
      [reactant("C","Carbon",1),reactant("O₂","Oxygen",1)],
      [product("CO₂","Carbon Dioxide","CO₂",1)],
      "C + O₂ → CO₂","combustion","exothermic",
      "Carbon burns in excess oxygen to produce CO₂. In limited oxygen, CO is produced instead.",
      ["Produces CO₂ in excess O₂","Incomplete combustion gives toxic CO","Burning coal is largely this reaction"],
      "inorganic",""),
    rxn("comb-ch4-o2","Combustion of Methane",
      [reactant("CH₄","Methane",1),reactant("O₂","Oxygen",2)],
      [product("CO₂","Carbon Dioxide","CO₂",1),product("H₂O","Water","H₂O",2)],
      "CH₄ + 2O₂ → CO₂ + 2H₂O","combustion","exothermic",
      "Methane (natural gas) burns producing CO₂ and water. Primary reaction in gas stoves.",
      ["Natural gas is mostly methane","Burns with blue flame","Releases ~890 kJ/mol"],
      "inorganic",""),
    rxn("comb-c3h8-o2","Combustion of Propane",
      [reactant("C₃H₈","Propane",1),reactant("O₂","Oxygen",5)],
      [product("CO₂","Carbon Dioxide","CO₂",3),product("H₂O","Water","H₂O",4)],
      "C₃H₈ + 5O₂ → 3CO₂ + 4H₂O","combustion","exothermic",
      "Propane (LPG) burns completely to produce CO₂ and water.",
      ["Used in gas grills and camping stoves","Stored as liquid under pressure","Burns cleanly with blue flame"],
      "inorganic",""),
    rxn("comb-mg-o2","Combustion of Magnesium",
      [reactant("Mg","Magnesium",2),reactant("O₂","Oxygen",1)],
      [product("MgO","Magnesium Oxide","MgO",2)],
      "2Mg + O₂ → 2MgO","combustion","exothermic",
      "Magnesium burns with an intensely bright white flame producing magnesium oxide.",
      ["Burns so brightly it can damage eyesight","Cannot be extinguished with water","Used in fireworks and flares"],
      "inorganic",""),
    rxn("comb-s-o2","Combustion of Sulfur",
      [reactant("S","Sulfur",1),reactant("O₂","Oxygen",1)],
      [product("SO₂","Sulfur Dioxide","SO₂",1)],
      "S + O₂ → SO₂","combustion","exothermic",
      "Sulfur burns in oxygen producing toxic SO₂. Key contributor to acid rain.",
      ["Blue flame","Choking pungent smell","SO₂ causes acid rain","Used in wine preservation"],
      "inorganic",""),
    rxn("comb-c2h5oh","Combustion of Ethanol",
      [reactant("C₂H₅OH","Ethanol",1),reactant("O₂","Oxygen",3)],
      [product("CO₂","Carbon Dioxide","CO₂",2),product("H₂O","Water","H₂O",3)],
      "C₂H₅OH + 3O₂ → 2CO₂ + 3H₂O","combustion","exothermic",
      "Ethanol burns completely in oxygen to form CO₂ and water. Used as biofuel.",
      ["Burns with pale blue flame","Biofuel application","~1370 kJ/mol energy"],
      "inorganic",""),
    rxn("comb-c4h10","Combustion of Butane",
      [reactant("C₄H₁₀","Butane",2),reactant("O₂","Oxygen",13)],
      [product("CO₂","Carbon Dioxide","CO₂",8),product("H₂O","Water","H₂O",10)],
      "2C₄H₁₀ + 13O₂ → 8CO₂ + 10H₂O","combustion","exothermic",
      "Butane burns completely. Used in lighters and portable stoves.",
      ["Used in cigarette lighters","Blue flame","~2878 kJ/mol"],
      "inorganic",""),
    // ── Inorganic: Acid-Base ──────────────────────────────────────────────
    rxn("acid-hcl-naoh","HCl + NaOH Neutralisation",
      [reactant("HCl","Hydrochloric Acid",1),reactant("NaOH","Sodium Hydroxide",1)],
      [product("NaCl","Sodium Chloride","NaCl",1),product("H₂O","Water","H₂O",1)],
      "HCl + NaOH → NaCl + H₂O","acid-base","exothermic",
      "Classic neutralisation of strong acid with strong base producing salt and water.",
      ["Exothermic, mixture warms up","Universal indicator turns green at pH 7","No gas produced"],
      "inorganic",""),
    rxn("acid-h2so4-naoh","H₂SO₄ + NaOH Neutralisation",
      [reactant("H₂SO₄","Sulfuric Acid",1),reactant("NaOH","Sodium Hydroxide",2)],
      [product("Na₂SO₄","Sodium Sulfate","Na₂SO₄",1),product("H₂O","Water","H₂O",2)],
      "H₂SO₄ + 2NaOH → Na₂SO₄ + 2H₂O","acid-base","exothermic",
      "Diprotic sulfuric acid requires two moles of NaOH. Very exothermic.",
      ["Two moles of NaOH per mole of H₂SO₄","Very exothermic, add acid to water","Product sodium sulfate used in detergents"],
      "inorganic",""),
    rxn("acid-hcl-caco3","HCl + Calcium Carbonate",
      [reactant("HCl","Hydrochloric Acid",2),reactant("CaCO₃","Calcium Carbonate",1)],
      [product("CaCl₂","Calcium Chloride","CaCl₂",1),product("H₂O","Water","H₂O",1),product("CO₂","Carbon Dioxide","CO₂",1)],
      "2HCl + CaCO₃ → CaCl₂ + H₂O + CO₂↑","acid-base","exothermic",
      "Acid reacts with limestone/chalk producing CO₂ gas. Explains acid rain erosion.",
      ["CO₂ fizzing","CO₂ turns limewater milky","Acid rain dissolves limestone buildings"],
      "inorganic",""),
    rxn("acid-acetic-naoh","Acetic Acid + NaOH",
      [reactant("CH₃COOH","Acetic Acid",1),reactant("NaOH","Sodium Hydroxide",1)],
      [product("CH₃COONa","Sodium Acetate","CH₃COONa",1),product("H₂O","Water","H₂O",1)],
      "CH₃COOH + NaOH → CH₃COONa + H₂O","acid-base","exothermic",
      "Weak acid + strong base neutralisation. Product is a buffer salt.",
      ["Weak acid + strong base","Buffer salt formed","Vinegar contains acetic acid"],
      "inorganic",""),
    rxn("acid-hcl-nahco3","HCl + Sodium Bicarbonate",
      [reactant("HCl","Hydrochloric Acid",1),reactant("NaHCO₃","Sodium Bicarbonate",1)],
      [product("NaCl","Sodium Chloride","NaCl",1),product("H₂O","Water","H₂O",1),product("CO₂","Carbon Dioxide","CO₂",1)],
      "HCl + NaHCO₃ → NaCl + H₂O + CO₂↑","acid-base","exothermic",
      "Acid reacts with baking soda releasing CO₂. Basis of antacid action.",
      ["Immediate vigorous fizzing","Antacid tablets work by this reaction","CO₂ causes familiar fizz in baking"],
      "inorganic",""),
    rxn("acid-hno3-naoh","HNO₃ + NaOH",
      [reactant("HNO₃","Nitric Acid",1),reactant("NaOH","Sodium Hydroxide",1)],
      [product("NaNO₃","Sodium Nitrate","NaNO₃",1),product("H₂O","Water","H₂O",1)],
      "HNO₃ + NaOH → NaNO₃ + H₂O","acid-base","exothermic",
      "Strong acid-base neutralisation forming sodium nitrate (used in fertilisers).",
      ["Strong acid + strong base","Sodium nitrate used in fertilisers","Exothermic"],
      "inorganic",""),
    rxn("acid-h3po4-naoh","H₃PO₄ + NaOH",
      [reactant("H₃PO₄","Phosphoric Acid",1),reactant("NaOH","Sodium Hydroxide",3)],
      [product("Na₃PO₄","Sodium Phosphate","Na₃PO₄",1),product("H₂O","Water","H₂O",3)],
      "H₃PO₄ + 3NaOH → Na₃PO₄ + 3H₂O","acid-base","exothermic",
      "Triprotic phosphoric acid requires 3 moles NaOH per mole of acid.",
      ["Triprotic acid","Phosphate salts used in food additives","Stepwise neutralisation possible"],
      "inorganic",""),
    // ── Inorganic: Synthesis ──────────────────────────────────────────────
    rxn("synth-na-cl2","Synthesis of NaCl",
      [reactant("Na","Sodium",2),reactant("Cl₂","Chlorine",1)],
      [product("NaCl","Sodium Chloride","NaCl",2)],
      "2Na + Cl₂ → 2NaCl","synthesis","exothermic",
      "Sodium reacts vigorously with chlorine gas to form table salt (NaCl).",
      ["Brilliant orange-yellow flame","Dense white NaCl smoke","Example of ionic compound formation"],
      "inorganic",""),
    rxn("synth-fe-s","Iron + Sulfur",
      [reactant("Fe","Iron",1),reactant("S","Sulfur",1)],
      [product("FeS","Iron(II) Sulfide","FeS",1)],
      "Fe + S → FeS","synthesis","exothermic",
      "Iron and sulfur heated together form FeS. Classic mixture vs compound demo.",
      ["Requires heating to initiate","Product is non-magnetic unlike iron","FeS reacts with acid to give toxic H₂S"],
      "inorganic",""),
    rxn("synth-h2-cl2","H₂ + Cl₂",
      [reactant("H₂","Hydrogen",1),reactant("Cl₂","Chlorine",1)],
      [product("HCl","Hydrogen Chloride","HCl",2)],
      "H₂ + Cl₂ → 2HCl","synthesis","exothermic",
      "Hydrogen and chlorine react explosively in UV light to form HCl gas.",
      ["Explosive in sunlight","Triggered by UV light","HCl dissolves in water to form hydrochloric acid"],
      "inorganic",""),
    rxn("synth-cao-h2o","Quicklime + Water",
      [reactant("CaO","Calcium Oxide",1),reactant("H₂O","Water",1)],
      [product("Ca(OH)₂","Calcium Hydroxide","Ca(OH)₂",1)],
      "CaO + H₂O → Ca(OH)₂","synthesis","exothermic",
      "Quicklime reacts violently with water in a highly exothermic reaction forming slaked lime.",
      ["Extremely exothermic, reaches 150°C","Slaked lime used in building mortar","Forms limewater when dissolved"],
      "inorganic",""),
    rxn("synth-so3-h2o","SO₃ + H₂O",
      [reactant("SO₃","Sulfur Trioxide",1),reactant("H₂O","Water",1)],
      [product("H₂SO₄","Sulfuric Acid","H₂SO₄",1)],
      "SO₃ + H₂O → H₂SO₄","synthesis","exothermic",
      "SO₃ reacts with water to form sulfuric acid. Final step in Contact Process.",
      ["Extremely exothermic","SO₃ absorbed in H₂SO₄ not water directly in industry","Forms oleum (H₂S₂O₇)"],
      "inorganic",""),
    rxn("synth-no-o2","NO + O₂",
      [reactant("NO","Nitric Oxide",2),reactant("O₂","Oxygen",1)],
      [product("NO₂","Nitrogen Dioxide","NO₂",2)],
      "2NO + O₂ → 2NO₂","synthesis","exothermic",
      "Nitric oxide oxidises in air to form brown nitrogen dioxide. Part of Ostwald Process.",
      ["Brown NO₂ gas formed","Part of Ostwald Process for HNO₃","Contributes to smog formation"],
      "inorganic",""),
    // ── Inorganic: Decomposition ──────────────────────────────────────────
    rxn("decomp-h2o-electrolysis","Electrolysis of Water",
      [reactant("H₂O","Water",2)],
      [product("H₂","Hydrogen","H₂",2),product("O₂","Oxygen","O₂",1)],
      "2H₂O → 2H₂ + O₂","decomposition","endothermic",
      "Water splits into hydrogen and oxygen by electrical energy. Key for green hydrogen.",
      ["H₂ at cathode, O₂ at anode","H₂:O₂ ratio = 2:1 by volume","Used to produce green hydrogen fuel"],
      "inorganic",""),
    rxn("decomp-caco3","Thermal Decomposition of CaCO₃",
      [reactant("CaCO₃","Calcium Carbonate",1)],
      [product("CaO","Calcium Oxide","CaO",1),product("CO₂","Carbon Dioxide","CO₂",1)],
      "CaCO₃ → CaO + CO₂","decomposition","endothermic",
      "Limestone decomposes above 840°C to quicklime and CO₂. First step in cement making.",
      ["Requires >840°C","CO₂ turns limewater milky","Industrial basis of cement"],
      "inorganic",""),
    rxn("decomp-h2o2","Decomposition of H₂O₂",
      [reactant("H₂O₂","Hydrogen Peroxide",2)],
      [product("H₂O","Water","H₂O",2),product("O₂","Oxygen","O₂",1)],
      "2H₂O₂ → 2H₂O + O₂","decomposition","exothermic",
      "H₂O₂ decomposes into water and oxygen, catalysed by MnO₂ or catalase enzyme.",
      ["MnO₂ or catalase catalyses","Elephant toothpaste demo","Glowing splint reignites in O₂"],
      "inorganic",""),
    rxn("decomp-kclo3","Decomposition of KClO₃",
      [reactant("KClO₃","Potassium Chlorate",2)],
      [product("KCl","Potassium Chloride","KCl",2),product("O₂","Oxygen","O₂",3)],
      "2KClO₃ → 2KCl + 3O₂","decomposition","endothermic",
      "Potassium chlorate decomposes on heating, generating oxygen gas. Catalysed by MnO₂.",
      ["Requires >400°C","MnO₂ lowers required temperature","Explosion risk with reducing agents"],
      "inorganic",""),
    rxn("decomp-nahco3","Decomposition of Baking Soda",
      [reactant("NaHCO₃","Sodium Bicarbonate",2)],
      [product("Na₂CO₃","Sodium Carbonate","Na₂CO₃",1),product("H₂O","Water","H₂O",1),product("CO₂","Carbon Dioxide","CO₂",1)],
      "2NaHCO₃ → Na₂CO₃ + H₂O + CO₂","decomposition","endothermic",
      "Baking soda decomposes on heating releasing CO₂. Makes baked goods rise.",
      ["CO₂ makes cakes and bread rise","Starts at ~50°C","Also used in fire extinguishers"],
      "inorganic",""),
    rxn("decomp-pb-no3","Decomposition of Lead Nitrate",
      [reactant("Pb(NO₃)₂","Lead Nitrate",2)],
      [product("PbO","Lead Oxide","PbO",2),product("NO₂","Nitrogen Dioxide","NO₂",4),product("O₂","Oxygen","O₂",1)],
      "2Pb(NO₃)₂ → 2PbO + 4NO₂ + O₂","decomposition","endothermic",
      "Lead nitrate releases brown toxic NO₂ on strong heating.",
      ["Brown NO₂ fumes visible","Toxic – perform in fume hood","White solid turns yellow PbO"],
      "inorganic",""),
    // ── Inorganic: Displacement ───────────────────────────────────────────
    rxn("disp-fe-cuso4","Iron Displaces Copper",
      [reactant("Fe","Iron",1),reactant("CuSO₄","Copper Sulfate",1)],
      [product("FeSO₄","Iron(II) Sulfate","FeSO₄",1),product("Cu","Copper","Cu",1)],
      "Fe + CuSO₄ → FeSO₄ + Cu","displacement","exothermic",
      "Iron displaces copper from copper sulfate. Blue solution fades and copper deposits.",
      ["Blue fades to pale green FeSO₄","Copper coats the iron","Classic reactivity series demo"],
      "inorganic",""),
    rxn("disp-zn-cuso4","Zinc Displaces Copper",
      [reactant("Zn","Zinc",1),reactant("CuSO₄","Copper Sulfate",1)],
      [product("ZnSO₄","Zinc Sulfate","ZnSO₄",1),product("Cu","Copper","Cu",1)],
      "Zn + CuSO₄ → ZnSO₄ + Cu","displacement","exothermic",
      "Zinc displaces copper from copper sulfate solution.",
      ["Blue fades, zinc more reactive than copper","Copper deposits on zinc","ZnSO₄ solution is colourless"],
      "inorganic",""),
    rxn("disp-zn-hcl","Zinc + HCl",
      [reactant("Zn","Zinc",1),reactant("HCl","Hydrochloric Acid",2)],
      [product("ZnCl₂","Zinc Chloride","ZnCl₂",1),product("H₂","Hydrogen","H₂",1)],
      "Zn + 2HCl → ZnCl₂ + H₂","displacement","exothermic",
      "Zinc reacts with HCl producing zinc chloride and hydrogen gas.",
      ["Steady H₂ bubbles","Zinc above hydrogen in reactivity","Squeaky pop confirms hydrogen"],
      "inorganic",""),
    rxn("disp-mg-hcl","Magnesium + HCl",
      [reactant("Mg","Magnesium",1),reactant("HCl","Hydrochloric Acid",2)],
      [product("MgCl₂","Magnesium Chloride","MgCl₂",1),product("H₂","Hydrogen","H₂",1)],
      "Mg + 2HCl → MgCl₂ + H₂","displacement","exothermic",
      "Magnesium reacts vigorously with HCl, more reactive than zinc or iron.",
      ["Vigorous fizzing","Mg ribbon dissolves rapidly","Tube warms noticeably"],
      "inorganic",""),
    rxn("disp-fe-hcl","Iron + HCl",
      [reactant("Fe","Iron",1),reactant("HCl","Hydrochloric Acid",2)],
      [product("FeCl₂","Iron(II) Chloride","FeCl₂",1),product("H₂","Hydrogen","H₂",1)],
      "Fe + 2HCl → FeCl₂ + H₂","displacement","exothermic",
      "Iron reacts slowly with HCl producing pale green FeCl₂ solution and hydrogen.",
      ["Slower than Mg or Zn","Solution turns pale green","Demonstrates reactivity order"],
      "inorganic",""),
    rxn("disp-cu-agno3","Copper Displaces Silver",
